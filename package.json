{
  "name": "@twango/twiki",
  "version": "0.7.2",
  "description": "Obsidian-compatible Markdown publishing for Cloudflare and static hosts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twangodev/twiki.git"
  },
  "bin": {
    "twiki": "cli/twiki.ts"
  },
  "exports": {
    ".": "./cli/runtime.ts",
    "./runtime": "./cli/runtime.ts",
    "./cli": "./cli/twiki.ts",
    "./schema": "./cli/twiki.schema.json"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2",
  "files": [
    "cli",
    "site/src",
    "site/tooling",
    "site/worker",
    "site/assets",
    "site/static/fonts",
    "site/static/favicon.ico",
    "site/migrations",
    "site/package.json",
    "site/bun.lock",
    "site/svelte.config.js",
    "site/vite.config.ts",
    "site/tsconfig.json",
    "site/wrangler.jsonc",
    "site/_headers",
    "site/_redirects",
    "site/database",
    "site/drizzle.config.ts",
    "bun.lock"
  ],
  "scripts": {
    "test": "bun test ./cli",
    "check": "bunx tsc --noEmit --skipLibCheck --module esnext --moduleResolution bundler --target es2022 --types bun --allowJs cli/twiki.ts cli/runtime.ts",
    "dev": "bun cli/twiki.ts dev",
    "dev:host": "bun cli/twiki.ts dev -- --host",
    "build": "bun cli/twiki.ts build",
    "release:pack": "bun tooling/release.ts pack",
    "release:smoke": "bun tooling/release.ts smoke",
    "docs:generate": "bun tooling/docs.ts",
    "docs:check": "bun tooling/docs.ts --check && bun test ./tooling/docs.test.ts",
    "docs:dev": "bun run docs:generate && bun cli/twiki.ts dev --project documentation"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@cloudflare/workers-types": "5.20261006.1",
    "@codemirror/commands": "6.11.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@floating-ui/dom": "1.7.6",
    "@flowershow/remark-wiki-link": "3.4.0",
    "@lucide/svelte": "1.17.0",
    "@playwright/test": "1.61.1",
    "@resvg/resvg-js": "2.6.2",
    "@rybbit/js": "0.6.2",
    "@sveltejs/adapter-cloudflare": "7.2.8",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.0",
    "@tweenjs/tween.js": "25.0.0",
    "@types/bun": "1.4.1",
    "@types/d3-drag": "3.0.7",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/hast": "3.0.4",
    "@types/js-yaml": "4.0.9",
    "@types/mdast": "4.0.4",
    "@types/node": "25.9.3",
    "better-auth": "1.7.2",
    "bits-ui": "2.18.1",
    "blake3-wasm": "2.1.5",
    "clsx": "2.1.1",
    "commander": "15.0.0",
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esrap": "2.2.11",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-string": "3.0.1",
    "ignore": "7.0.5",
    "js-yaml": "3.15.2",
    "katex": "0.18.2",
    "material-icon-theme": "5.38.1",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "11.16.1",
    "mime": "4.0.7",
    "miniflare": "5.20261023.0-beta",
    "mode-watcher": "1.1.0",
    "pagefind": "1.5.2",
    "photoswipe": "5.4.4",
    "pixi.js": "8.19.0",
    "prettier": "3.8.4",
    "prettier-plugin-svelte": "4.1.0",
    "prettier-plugin-tailwindcss": "0.8.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-smartypants": "3.0.2",
    "rolldown": "1.0.3",
    "satori": "0.33.4",
    "shiki": "4.2.0",
    "simple-icons": "16.29.0",
    "svelte": "5.56.3",
    "svelte-check": "4.6.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.1.6",
    "webr": "0.5.8",
    "wrangler": "4.153.0",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  }
}
