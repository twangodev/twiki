    "@types/hast": "3.0.5",
    "@types/js-yaml": "4.0.9",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "better-auth": "1.7.2",
    "bits-ui": "2.20.2",
    "blake3-wasm": "2.1.5",
    "clsx": "2.1.1",
    "commander": "15.0.0",
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "drizzle-kit": "0.31.11",
