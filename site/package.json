{
	"name": "wisconsin-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build:content": "bun scripts/build-content.ts",
		"build:search": "pagefind --site .svelte-kit/cloudflare",
		"build:all": "bun run build:content && bun run build && bun run build:search",
		"prepare:static": "bun scripts/prepare-static.ts",
		"test": "bun test scripts",
		"dev": "bun scripts/prepare-static.ts && vite dev",
		"dev:host": "bun scripts/prepare-static.ts && vite dev --host",
		"build": "bun scripts/prepare-static.ts && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@floating-ui/dom": "^1",
		"@lucide/svelte": "^1.17.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.65.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3-force": "^3.0.10",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^25.9.3",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"d3-force": "^3.0.0",
		"github-slugger": "^2.0.0",
		"gray-matter": "^4.0.3",
		"hast-util-to-html": "^9.0.5",
		"hast-util-to-string": "^3.0.1",
		"katex": "^0.17.0",
		"layerchart": "2.0.0-next.65",
		"mdast-util-find-and-replace": "^3.0.2",
		"mdast-util-to-hast": "^13.2.1",
		"mdast-util-to-string": "^4.0.0",
		"mermaid": "^11.15.0",
		"mode-watcher": "^1.1.0",
		"pagefind": "^1.5.2",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"remark-smartypants": "^3.0.2",
		"shiki": "^4.2.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.0.16",
		"wrangler": "^4.100.0"
	}
}
