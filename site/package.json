{
  "name": "twiki-engine",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "publish:check": "bun tooling/publish.ts",
    "db:generate": "drizzle-kit generate",
    "content:prepare": "bun tooling/prepare.ts",
    "build:all": "bun tooling/build.ts",
    "test": "bun run --sequential test:unit test:browser",
    "test:unit": "bun test ./tests/unit",
    "test:browser": "bun test ./tests/browser",
    "test:e2e": "playwright test",
    "test:publishing": "bun tests/publication.ts",
    "dev": "vite dev",
    "dev:host": "vite dev --host",
    "build": "vite build",
    "preview": "bun tooling/wrangler.ts dev --persist-to build/.wrangler/state --port 4173",
    "prepare": "TWIKI_SKIP_CONTENT=1 svelte-kit sync",
    "check": "bun run --sequential --no-exit-on-error check:types check:links check:targets check:diagrams",
    "check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p worker/tsconfig.json",
    "check:links": "bun tooling/check-links.ts",
    "check:targets": "bun tooling/check-targets.ts",
    "check:diagrams": "bun tooling/check-diagrams.ts",
    "test:content": "bun tests/content-dev.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "build:app": "bun tooling/build.ts --app",
    "build:static": "bun tooling/build.ts --static",
    "deploy:incremental": "bun tooling/deploy.ts --upload"
  },
  "dependencies": {
    "@better-auth/core": "1.7.2",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@cloudflare/workers-types": "5.20261027.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@floating-ui/dom": "1.8.0",
    "@flowershow/remark-wiki-link": "3.4.0",
    "@lucide/svelte": "1.62.0",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@rybbit/js": "0.6.3",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tweenjs/tween.js": "25.0.0",
    "@types/bun": "1.4.4",
    "@types/d3-drag": "3.0.7",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.12",
