{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "wisconsin",
	"compatibility_date": "2026-06-07",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"vars": {
		"ORIGIN": "https://wisconsin.twango.dev"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		// Match SvelteKit's trailingSlash='never' contract at the edge.
		"html_handling": "drop-trailing-slash",
		// Serve the prerendered /404 page from the asset layer for unknown URLs.
		"not_found_handling": "404-page",
		// Keep prerendered pages on the globally cached asset path. Cloudflare
		// Access still authenticates requests before they reach this Worker.
		"run_worker_first": false
	},
	"workers_dev": true,
	"preview_urls": true
}
